// clang-format off
DEFINE_UI_PARAMS(k_grid_resolution, K Resolution, DCTLUI_SLIDER_FLOAT, 100.0, 1.0, 1000.0, 0.001)
DEFINE_UI_PARAMS(cmy_grid_resolution, CMY Resolution, DCTLUI_SLIDER_FLOAT, 100.0, 1.0, 1000.0, 0.001)
DEFINE_UI_PARAMS(k_grid_angle, K Grid Angle, DCTLUI_SLIDER_FLOAT, 15.0, 0.0, 45.0, 0.001)
DEFINE_UI_PARAMS(k_grid_offset_x, K Grid Offset X, DCTLUI_SLIDER_FLOAT, 0.0, 0.0, 1.0, 0.01)
DEFINE_UI_PARAMS(k_grid_offset_y, K Grid Offset Y, DCTLUI_SLIDER_FLOAT, 0.0, 0.0, 1.0, 0.01)
DEFINE_UI_PARAMS(c_grid_angle, C Grid Angle, DCTLUI_SLIDER_FLOAT, 0.0, 0.0, 45.0, 0.001)
DEFINE_UI_PARAMS(c_grid_offset_x, C Grid Offset X, DCTLUI_SLIDER_FLOAT, 0.5, 0.0, 1.0, 0.01)
DEFINE_UI_PARAMS(c_grid_offset_y, C Grid Offset Y, DCTLUI_SLIDER_FLOAT, 0.5, 0.0, 1.0, 0.01)
DEFINE_UI_PARAMS(m_grid_angle, M Grid Angle, DCTLUI_SLIDER_FLOAT, 45.0, 0.0, 45.0, 0.001)
DEFINE_UI_PARAMS(m_grid_offset_x, M Grid Offset X, DCTLUI_SLIDER_FLOAT, 0.0, 0.0, 1.0, 0.01)
DEFINE_UI_PARAMS(m_grid_offset_y, M Grid Offset Y, DCTLUI_SLIDER_FLOAT, 0.5, 0.0, 1.0, 0.01)
DEFINE_UI_PARAMS(y_grid_angle, Y Grid Angle, DCTLUI_SLIDER_FLOAT, 30.0, 0.0, 45.0, 0.001)
DEFINE_UI_PARAMS(y_grid_offset_x, Y Grid Offset X, DCTLUI_SLIDER_FLOAT, 0.5, 0.0, 1.0, 0.01)
DEFINE_UI_PARAMS(y_grid_offset_y, Y Grid Offset Y, DCTLUI_SLIDER_FLOAT, 0.0, 0.0, 1.0, 0.01)
DEFINE_UI_PARAMS(circle_smoothening, Circle Smoothening, DCTLUI_SLIDER_FLOAT, 0.125, 0.0, 0.50, 0.001)
DEFINE_UI_PARAMS(jitter, Jitter, DCTLUI_CHECK_BOX, 0)
